# Local development: use a TCP MySQL endpoint.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=saint_bernard_procurement
DB_USER=app_user
DB_PASS=replace-me
DB_POOL_MAX=5
# Set to true only to initialize a brand-new empty database.
# DB_SYNC=true

# Cloud Run: do not set DB_HOST. Set this instead.
# INSTANCE_UNIX_SOCKET=/cloudsql/PROJECT_ID:REGION:INSTANCE_ID

# Local-only Firebase Admin credential. Do not deploy a service-account JSON file.
# FIREBASE_ADMIN_SDK_PATH=path/to/service-account.json
